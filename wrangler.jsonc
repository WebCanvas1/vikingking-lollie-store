{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vikingking-lollie-store",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "vikingking-store",
    "database_id": "2b2cec59-3f71-4514-92b5-8ad45f263c5c",
    "migrations_dir": "migrations"
  }
],
  "r2_buckets": [{
    "binding": "MEDIA_BUCKET",
    "bucket_name": "vikingking-media"
  }],
  "vars": {
    "APP_URL": "https://www.vikinglolliemix.com.au",
    "ORDER_EMAIL_FROM": "VikingKing Lollie Mix <orders@vikinglolliemix.com.au>",
    "ORDER_EMAIL_REPLY_TO": "lensairways1@icloud.com",
    "ADMIN_ORDER_EMAIL": "lensairways1@icloud.com",
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_SECRET_KEY": "",
    "GA4_MEASUREMENT_ID": ""
  }
}
